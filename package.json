{
  "name": "sunasty-color-math",
  "version": "1.0.0",
  "description": "Zero-dependency sRGB, HEX, HSL, and perceptual OKLCH color conversion engine with WCAG 2.1 contrast calculation, AA lightness auto-fix, Tailwind CSS shade matching, and RGBA palette quantization.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test.js"
  },
  "keywords": [
    "color",
    "oklch",
    "oklab",
    "srgb",
    "hex",
    "hsl",
    "wcag",
    "contrast",
    "accessibility",
    "tailwind",
    "palette",
    "quantization"
  ],
  "author": "Sunasty <https://sunasty.com>",
  "license": "MIT",
  "homepage": "https://sunasty.com/color-picker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bsulyan/sunasty-color-math.git"
  },
  "bugs": {
    "url": "https://github.com/bsulyan/sunasty-color-math/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
